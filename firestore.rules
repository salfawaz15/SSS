rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ملاحظة (المرحلة 2 من إعادة هيكلة الدخول، 2026-08-15): كل دالة أدناه
    // تقبل الآن **إما** البريد الحرفي الثابت القديم (حسابات الأدوار المشتركة
    // الحالية، ستُلغى لاحقًا) **أو** Custom Claim الجديد (role) على حساب
    // الشخص الفردي (رقم منسوب) - إضافية بحتة، لا تُبطل أي حساب حالي.
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'admin@sss-advising-tu.internal' ||
         request.auth.token.email == 'salfawaz@sss-advising-tu.internal' ||
         request.auth.token.role == 'admin' ||
         request.auth.token.role == 'super_admin');
    }

    // حساب المدير العام (salfawaz) فقط - صلاحيات إضافية حصرية عليه لا يملكها
    // حساب الإدارة العادي (admin@)، مثل تعديل بيانات منسّقي الأقسام.
    function isSuperAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'salfawaz@sss-advising-tu.internal' ||
         request.auth.token.role == 'super_admin');
    }

    // حسابا عرض للتقارير فقط (أمين الوحدة وسكرتيرة الوحدة) - قراءة فقط،
    // بلا أي صلاحية رفع أو تعديل أو تنزيل ملفات الأقسام.
    function isViewer() {
      return request.auth != null &&
        (request.auth.token.email == 'ameen@sss-advising-tu.internal' ||
         request.auth.token.email == 'secretary@sss-advising-tu.internal' ||
         request.auth.token.role == 'ameen' ||
         request.auth.token.role == 'secretary');
    }

    // منسّق الوحدة للشؤون الإدارية - بريد ثابت واحد بلا مستند حساب منفصل (لا
    // تفريع شطر/قسم كمنسّقي الأقسام)، صلاحيته الوحيدة رفع الملفات فقط عبر
    // شاشة مخصَّصة.
    function isUnitCoordinator() {
      return request.auth != null &&
        (request.auth.token.email == 'unit-coordinator@sss-advising-tu.internal' ||
         request.auth.token.role == 'unit_coordinator');
    }

    // منسّق مسار نوعي (الإرشاد الأكاديمي، الرعاية الطلابية، البيانات
    // والجودة والتطوير، الخريجين، الموهوبين...) - دور جديد كليًا، بلا أي
    // حساب قديم مواز، فيُقرأ من الـ Claim مباشرة بلا حاجة لمستند حساب.
    function isTrackCoordinatorFor(track) {
      return request.auth != null &&
        request.auth.token.role == 'track_coordinator' &&
        request.auth.token.track == track;
    }

    function coordinatorAccount() {
      return get(/databases/$(database)/documents/coordinator_accounts/$(request.auth.uid)).data;
    }

    function isCoordinatorFor(shatr, department) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/coordinator_accounts/$(request.auth.uid)) &&
        coordinatorAccount().shatr == shatr &&
        coordinatorAccount().department == department;
    }

    // منسّق/ة الكلية (المستوى الثالث في مسار التصعيد: مرشد -> منسّق قسم ->
    // منسّق الكلية) - يرى كل أقسام شطره مجتمعة، لا قسمًا واحدًا فقط.
    function collegeCoordinatorAccount() {
      return get(/databases/$(database)/documents/college_coordinator_accounts/$(request.auth.uid)).data;
    }

    function isCollegeCoordinatorFor(shatr) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/college_coordinator_accounts/$(request.auth.uid)) &&
        collegeCoordinatorAccount().shatr == shatr;
    }

    match /tickets/{ticketId} {
      allow read, write: if isAdmin();

      // منسّق الوحدة: نفس صلاحية رفع الملف الأساسي المتاحة للإدارة (قراءة
      // مطلوبة فعليًا لأن دمج الرفعات التراكمية يقرأ التذاكر الحالية أولاً
      // ليعرف الجديد منها) - بلا أي صلاحية أخرى غير هذه.
      allow read, write: if isUnitCoordinator();

      allow read: if isCoordinatorFor(resource.data.shatr, resource.data.department);

      allow read: if isCollegeCoordinatorFor(resource.data.shatr);

      allow read: if isViewer();

      allow update: if isCoordinatorFor(resource.data.shatr, resource.data.department) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actions']) &&
        request.resource.data.shatr == resource.data.shatr &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.university_id == resource.data.university_id;

      allow update: if isCollegeCoordinatorFor(resource.data.shatr) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actions']) &&
        request.resource.data.shatr == resource.data.shatr &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.university_id == resource.data.university_id;
    }

    match /coordinator_accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /college_coordinator_accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // إحصائيات علنية موجزة تُعرض في الصفحة الرئيسية العامة قبل تسجيل
    // الدخول (بدون كشف أي بيانات طالب فردية) - قراءة عامة للجميع، وكتابة
    // للإدارة فقط (تُحدَّث تلقائيًا من لوحة الإدارة عند أي تغيير في البيانات).
    match /public_stats/summary {
      allow read: if true;
      allow write: if isAdmin();
    }

    // تشكيل وحدة الإرشاد الأكاديمي والخريجين (رئيس/نائب/أمين/منسّقون...)
    // المعروض في صفحة "تواصل معنا" العامة - قراءة عامة للجميع (بلا تسجيل
    // دخول)، وكتابة للإدارة فقط (تُحدَّث تلقائيًا عند رفع ملف منسوبي الكلية
    // إن تضمّن ورقة "تشكيل الوحدة" - انظر college_roster_admin_screen.dart).
    match /public_unit_committee/current {
      allow read: if true;
      allow write: if isAdmin();
    }

    // حسابات موظفي البوابة الفردية (رقم منسوب لكل شخص، ودوره Custom Claim
    // على حسابه) - المرحلة 1 من إعادة هيكلة الدخول (2026-08-15). الكتابة
    // حصرًا عبر أداة سطر الأوامر السرّية (Admin SDK، تتجاوز هذه القواعد) -
    // لا كتابة من التطبيق نفسه إطلاقًا. كل شخص يقرأ وثيقته الخاصة فقط
    // (للتحقّق من دوره وعلم "يجب تغيير كلمة المرور" بعد الدخول).
    match /portal_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // الاستثناء الوحيد: الشخص نفسه يُطفئ علم "يجب تغيير كلمة المرور" بعد
      // نجاح التغيير الفعلي (FirebaseAuth.updatePassword) - لا يملك تعديل أي
      // حقل آخر بوثيقته (الدور وغيره تبقى حصرًا لأداة سطر الأوامر).
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']) &&
        request.resource.data.mustChangePassword == false;
      allow create, delete: if false;
    }

    // بيانات منسّقي الأقسام (اسم + بريد رسمي) - تُعرض علنًا في الصفحة
    // الرئيسية قبل تسجيل الدخول، لكن التعديل مقصور على حساب الإدارة الكامل
    // (admin/salfawaz) فقط.
    match /coordinator_contacts/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // حالات الظروف الخاصة: يسجّلها منسّق القسم لقسمه/شطره فقط بعد اعتماد
    // نموذج توثيق الحالة الورقي، وتراها إدارة الوحدة كاملة عبر كل الأقسام
    // لمتابعة ما تم بشأن كل حالة. لا صلاحية حذف لأي طرف - سجل تاريخي دائم.
    match /hardship_cases/{caseId} {
      allow read, update: if isAdmin();

      allow read: if isCoordinatorFor(resource.data.shatr, resource.data.department);

      allow create: if isCoordinatorFor(request.resource.data.shatr, request.resource.data.department);

      allow update: if isCoordinatorFor(resource.data.shatr, resource.data.department) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history']) &&
        request.resource.data.student_name == resource.data.student_name &&
        request.resource.data.university_id == resource.data.university_id &&
        request.resource.data.shatr == resource.data.shatr &&
        request.resource.data.department == resource.data.department;

      // منسّق مسار الرعاية الطلابية: يرى ويدير حالات كل الأقسام (نُقلت هذه
      // المسؤولية إليه من منسّقي الأقسام - 2026-08-15).
      allow read, create: if isTrackCoordinatorFor('student_care');
      allow update: if isTrackCoordinatorFor('student_care') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history']) &&
        request.resource.data.student_name == resource.data.student_name &&
        request.resource.data.university_id == resource.data.university_id;
    }

    // حالات الدعم النفسي والاجتماعي: نفس آلية حالات الظروف الخاصة بالضبط
    // لكن في مجموعة منفصلة تمامًا لحساسية طبيعتها.
    match /support_cases/{caseId} {
      allow read, update: if isAdmin();

      allow read: if isCoordinatorFor(resource.data.shatr, resource.data.department);

      allow create: if isCoordinatorFor(request.resource.data.shatr, request.resource.data.department);

      allow update: if isCoordinatorFor(resource.data.shatr, resource.data.department) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history']) &&
        request.resource.data.student_name == resource.data.student_name &&
        request.resource.data.university_id == resource.data.university_id &&
        request.resource.data.shatr == resource.data.shatr &&
        request.resource.data.department == resource.data.department;

      // منسّق مسار الرعاية الطلابية: يرى ويدير حالات كل الأقسام (نُقلت هذه
      // المسؤولية إليه من منسّقي الأقسام - 2026-08-15).
      allow read, create: if isTrackCoordinatorFor('student_care');
      allow update: if isTrackCoordinatorFor('student_care') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history']) &&
        request.resource.data.student_name == resource.data.student_name &&
        request.resource.data.university_id == resource.data.university_id;
    }

    // إعدادات إصدار تطبيق CBA Advising (رقم الإصدار الحالي + رابط تنزيل
    // الملف) - تُقرأ من داخل التطبيق نفسه للتحقق من توفر تحديث جديد، قراءة
    // عامة للجميع (لا بيانات حساسة)، وتعديل مقصور على حساب الإدارة الكامل.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // قائمة مرشدي كل قسم (اسم + هل هو منسّق قسم) - تُستخدم لتوزيع حالات
    // منسّق القسم على بقية المرشدين خلال فترة الحذف والإضافة. يقرؤها كل من
    // الإدارة والمنسّقين (بحاجتها عند تنزيل ملف قسمهم)، وتعديلها للإدارة فقط.
    match /advisor_roster/{advisorId} {
      allow read: if isAdmin() || isViewer() ||
        (request.auth != null && exists(/databases/$(database)/documents/coordinator_accounts/$(request.auth.uid)));
      allow write: if isAdmin();
    }

    // تقارير المراحل الثلاث المجمَّدة (مرشدون / منسّق قسم / منسّق كلية) -
    // وثيقة ثابتة تُنشأ عند "تجميد" مرحلة، ولا تُعدَّل أو تُحذف أبدًا بعد
    // إنشائها (لا قاعدة update/delete هنا عمدًا) حتى تبقى توثيقًا تاريخيًا
    // موثوقًا لما أنجزه كل مستوى، حتى لو تغيّرت بيانات tickets لاحقًا.
    match /stage_snapshots/{snapshotId} {
      allow read: if isAdmin() || isViewer();

      allow read: if resource.data.department != '__ALL__' &&
        isCoordinatorFor(resource.data.shatr, resource.data.department);

      allow read: if resource.data.department == '__ALL__' &&
        isCollegeCoordinatorFor(resource.data.shatr);

      allow create: if isAdmin() ||
        (request.resource.data.department != '__ALL__' &&
          isCoordinatorFor(request.resource.data.shatr, request.resource.data.department)) ||
        (request.resource.data.department == '__ALL__' &&
          isCollegeCoordinatorFor(request.resource.data.shatr));
    }

    // دليل مقررات الحذف والإضافة (جدول تسكين الشعب لكل شطر) - رفع وقراءة
    // مقصوران على حساب المدير العام (salfawaz) فقط، حسب طلبه صراحةً.
    match /courseSchedules/{shatrId} {
      allow read, write: if isSuperAdmin();

      // منسّق الوحدة: رفع جدول الشطرين فقط - القراءة ضرورية للتحقق من أن
      // تاريخ سحب الملف المرفوع أحدث من آخر نسخة معتمدة قبل الاستبدال.
      allow read, write: if isUnitCoordinator();
    }

    // قوائم مواد خارج الكلية المعتمدة لكل شطر (ناتجة عن تقاطع القائمة الثابتة
    // مع ملف حويّة الجامعة الشامل) - نفس صلاحيات courseSchedules تمامًا.
    match /outsideCourses/{shatrId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
    }

    // تقرير "بيانات الطلبة الأكاديمية حسب الكلية والقسم" المعتمد لكل شطر -
    // مصدر صفحة "متابعة حالات الإرشاد" - نفس صلاحيات courseSchedules تمامًا.
    // السجلات مُقسَّمة لدفعات (chunks) تحت كل مستند شطر (يتجاوز حد 1 ميجابايت
    // للمستند الواحد إن حُفظت كمصفوفة واحدة) - قاعدة المستند الأب لا تشمل
    // المجموعات الفرعية تلقائيًا في Firestore، فلازم قاعدة صريحة لها وإلا
    // تُرفَض كل قراءة/كتابة بصمت (تقع على القاعدة الافتراضية أسفل الملف).
    match /advisingReports/{shatrId} {
      allow read, write: if isSuperAdmin();
      // منسّق الوحدة: رفع تقرير "بيانات الطلبة الأكاديمية" - القراءة ضرورية
      // لأن اعتماد نسخة جديدة يحرّك النسخة الحالية أولاً إلى advisingReportsPrevious.
      allow read, write: if isUnitCoordinator();
      match /chunks/{chunkId} {
        allow read, write: if isSuperAdmin();
        allow read, write: if isUnitCoordinator();
      }
    }

    // النسخة السابقة من بيانات الطلبة (قبل آخر رفعة) - مصدر "النطاق السابق"
    // للمعدل - نفس الصلاحيات تمامًا.
    match /advisingReportsPrevious/{shatrId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
      match /chunks/{chunkId} {
        allow read, write: if isSuperAdmin();
        allow read, write: if isUnitCoordinator();
      }
    }

    // تقريرا "طلاب تابعين لمرشد" و"طلاب غير تابعين لمرشد" (ربط المرشد) لكل
    // شطر - يُدمَجان مع advisingReports عند التحليل - نفس الصلاحيات تمامًا.
    match /advisingAssignedReports/{shatrId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
      match /chunks/{chunkId} {
        allow read, write: if isSuperAdmin();
        allow read, write: if isUnitCoordinator();
      }
    }
    match /advisingUnassignedReports/{shatrId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
      match /chunks/{chunkId} {
        allow read, write: if isSuperAdmin();
        allow read, write: if isUnitCoordinator();
      }
    }
    // تقرير "الحالة الصحية للطلبة" (ذوو الإعاقة/الحالات الخاصة) لكل شطر -
    // نفس الصلاحيات تمامًا.
    match /advisingHealthReports/{shatrId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
      match /chunks/{chunkId} {
        allow read, write: if isSuperAdmin();
        allow read, write: if isUnitCoordinator();
      }
    }
    // تقرير "طلاب على غير مرشدهم" الرسمي من الجامعة (للمقارنة والتحقق من
    // حالات الانتداب) لكل شطر - نفس الصلاحيات تمامًا.
    match /advisingMismatchReports/{shatrId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
      match /chunks/{chunkId} {
        allow read, write: if isSuperAdmin();
        allow read, write: if isUnitCoordinator();
      }
    }

    // تقرير "كل الكليات" غير المفلتَر (طلاب تابعين لمرشد، الجامعة كاملة) -
    // المصدر الوحيد الحالي لتوزيع الطلبة على المرشدين، ونسخته السابقة (مصدر
    // "تقرير حركات الإرشاد") - نفس الصلاحيات ونمط chunks تمامًا مثل
    // advisingReports. أُضيفتا 2026-08-14 بعد اكتشاف أن غيابهما هنا كان يمنع
    // كل رفعة بصمت (permission-denied) رغم عمل الكود بشكل صحيح.
    match /advisingAllCollegesReports/{shatrId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
      match /chunks/{chunkId} {
        allow read, write: if isSuperAdmin();
        allow read, write: if isUnitCoordinator();
      }
    }
    match /advisingAllCollegesReportsPrevious/{shatrId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
      match /chunks/{chunkId} {
        allow read, write: if isSuperAdmin();
        allow read, write: if isUnitCoordinator();
      }
    }

    // سجل حركات الإرشاد الدائم/التراكمي (طالب تغيّر مرشده، عبر كل الرفعات لا
    // آخر رفعتين فقط) - مستندات مستقلة (لا chunks)، تُضاف فقط ولا تُعدَّل.
    match /advisingAdvisorMovements/{entryId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
    }

    // سجل تغييرات جدول المقررات الدائم/التراكمي (إضافة/حذف شعب، تغيير عضو
    // هيئة تدريس - عبر كل رفعات "رفع المقررات الدراسية") - نفس مبدأ
    // advisingAdvisorMovements تمامًا: مستندات مستقلة، تُضاف فقط ولا تُعدَّل.
    match /courseScheduleChanges/{entryId} {
      allow read, write: if isSuperAdmin();
      allow read, write: if isUnitCoordinator();
    }

    // بيانات منسوبي الكلية الرسمية (أعضاء هيئة تدريس وإداريين) - رفع وقراءة
    // مقصوران على حساب المدير العام (salfawaz) فقط، نفس مبدأ courseSchedules.
    match /collegeRoster/{docId} {
      allow read, write: if isSuperAdmin();
      // منسّق الوحدة: رفع بيانات منسوبي الكلية - القراءة ضرورية للتحقق من
      // تاريخ آخر حفظ للملف قبل الاستبدال.
      allow read, write: if isUnitCoordinator();
    }

    // جدول توزيع فترات الإرشاد الأكاديمي الموحّد لكل (قسم × شطر) - رفع
    // وقراءة مقصوران على حساب المدير العام فقط.
    match /advisingSchedules/{docId} {
      allow read, write: if isSuperAdmin();
      // منسّق الوحدة: رفع توزيع فترات الإرشاد فقط.
      allow read, write: if isUnitCoordinator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
